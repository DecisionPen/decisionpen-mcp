# Copy to repo root as .env.mcp (do not commit .env.mcp)

# --- DecisionPen API (required for research + ingestion push) ---
DP_API_BASE=https://YOUR_DECISIONPEN_HOST
# Admin → Security & audit → Edge API tokens
DP_API_TOKEN=dp_edge_...
# Or session JWT for interactive trials only:
# DP_API_TOKEN=paste-jwt-from-browser

# cite_only = research / cite S3 without persist
# propose   = also push enrichment to Insights Inbox
DP_MCP_MODE=cite_only

# --- S3 (optional — only for Edge list/get/propose/sync) ---
# DP_S3_BUCKET=your-bucket-name
# DP_S3_PREFIX=architecture/
# DP_S3_REGION=us-east-1
# AWS_PROFILE=your-profile
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Optional runtime ---
# DP_TENANT_ID=your-org-uuid
# DP_SYNC_STATE_PATH=sync_state.json
# DP_MCP_AUDIT_LOG=.decisionpen_mcp_audit.jsonl
# DP_MCP_MAX_OBJECT_BYTES=10485760
# DP_MCP_MAX_TEXT_CHARS=100000

# Copy to edge.env and fill in. Never commit real secrets.

# Product API for edge sync (not mcp.decisionpen.com, not the SPA).
DP_API_BASE=https://api.decisionpen.com
# Admin → Security & audit → Edge API tokens (or session JWT for manual tests)
DP_API_TOKEN=dp_edge_...

DP_MCP_MODE=propose
DP_S3_BUCKET=my-ea-docs
DP_S3_PREFIX=architecture/
# DP_S3_REGION=us-east-1

# Prefer IAM role when running on AWS. Otherwise:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=

DP_SYNC_STATE_PATH=/data/sync_state.json
DP_MCP_AUDIT_LOG=/data/audit.jsonl
